---
layout: layouts/base.njk
---
{% from "components/macros.njk" import statusBadge, nieuwsbriefCta, afbeelding %}
{%- set s = statussen[status] -%}
<div class="wrap">
  <nav class="kruimelpad" aria-label="Kruimelpad">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/projecten/">Plannen en projecten</a></li>
      <li><a href="{{ page.url }}" aria-current="page">{{ title }}</a></li>
    </ol>
  </nav>

  <header class="page-intro">
    <p class="page-intro__status">{{ statusBadge(status, statussen) }} <span class="status-uitleg">{{ s.uitleg }}</span></p>
    <h1>{{ title }}</h1>
    <p class="lead">{{ samenvatting }}</p>
  </header>

  {{ afbeelding(foto, site) }}

  <div class="project-body">
    <div class="prose">
      {{ content | safe }}

      <h2>Doel</h2>
      {{ doel | md | safe }}

      <h2>Wat er al is gebeurd</h2>
      <ul>
        {%- for item in gedaan %}
        <li>{{ item | mdInline | safe }}</li>
        {%- endfor %}
      </ul>

      <h2>Volgende stappen</h2>
      <ol>
        {%- for item in volgende_stappen %}
        <li>{{ item | mdInline | safe }}</li>
        {%- endfor %}
      </ol>

      <h2>Zo kun je betrokken raken</h2>
      <ul>
        {%- for item in meedoen %}
        <li>{{ item | mdInline | safe }}</li>
        {%- endfor %}
      </ul>

      {%- if bronnen and bronnen.length %}
      <h2>Links en bronnen</h2>
      <ul class="bronlijst">
        {%- for b in bronnen %}
        <li><a href="{{ b.url }}">{{ b.titel }}</a>{% if b.bron %} <span class="bronlijst__meta">({{ b.bron }})</span>{% endif %}</li>
        {%- endfor %}
      </ul>
      {%- endif %}

      <p class="bijgewerkt">Laatste inhoudelijke update: <time datetime="{{ bijgewerkt | datumISO }}">{{ bijgewerkt | datumNL }}</time></p>
    </div>
  </div>

  {{ nieuwsbriefCta(site, titel="Op de hoogte blijven van dit project?", tekst="Nieuws over dit en andere projecten delen we via de nieuwsbrief.") }}
</div>
