{#
  Herbruikbare bouwstenen. Gebruik in een pagina met:
  {% from "components/macros.njk" import statusBadge, nieuwsbriefCta, bronKaart, infoBlok, projectKaart %}
#}

{# Klein vormpje bij een status: vol, half, kwart of leeg. Puur decoratief. #}
{% macro statusIcoon(vorm) -%}
<svg class="status__icoon" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/>
{%- if vorm == "vol" %}<circle cx="6" cy="6" r="5" fill="currentColor"/>
{%- elif vorm == "half" %}<path d="M6 1a5 5 0 0 1 0 10Z" fill="currentColor"/>
{%- elif vorm == "kwart" %}<path d="M6 6V1a5 5 0 0 1 5 5Z" fill="currentColor"/>
{%- endif %}</svg>
{%- endmacro %}

{# Statuslabel van een project. Kleur is aanvullend; het label staat altijd in tekst. #}
{% macro statusBadge(sleutel, statussen) -%}
{%- set s = statussen[sleutel] -%}
<span class="status status--{{ sleutel }}">{{ statusIcoon(s.symbool) }}<span class="visually-hidden">Status: </span>{{ s.label }}</span>
{%- endmacro %}

{# De primaire actie van de site. Gebruik hem één keer per pagina. #}
{% macro nieuwsbriefCta(site, titel="Blijf op de hoogte", tekst="Schrijf je in voor de nieuwsbrief en blijf op de hoogte van plannen, projecten en mogelijkheden om mee te doen.", kopNiveau=2) -%}
<section class="cta" aria-labelledby="cta-titel">
  <h{{ kopNiveau }} id="cta-titel" class="cta__titel">{{ titel }}</h{{ kopNiveau }}>
  <p>{{ tekst }}</p>
  <p><a class="button" href="{{ site.nieuwsbrief.url }}">{{ site.nieuwsbrief.knoptekst }}<span class="visually-hidden"> (externe website van Zendlijst)</span></a></p>
  <p class="cta__noot">Je schrijft je in op de website van Zendlijst, de externe dienst waarmee we de nieuwsbrief versturen. Je geeft daar alleen je e-mailadres op. Lees meer in onze <a href="/privacy/">privacyverklaring</a>.</p>
</section>
{%- endmacro %}

{# Kaart voor een externe regeling of bron in de wegwijzer. #}
{% macro bronKaart(bron, kopNiveau=3) -%}
<article class="kaart bron">
  <h{{ kopNiveau }} class="kaart__titel">{{ bron.titel }}</h{{ kopNiveau }}>
  <dl class="bron__gegevens">
    {%- if bron.voor_wie %}
    <dt>Voor wie</dt>
    <dd>{{ bron.voor_wie }}</dd>
    {%- endif %}
    {%- if bron.voorwaarden %}
    <dt>Belangrijkste punten</dt>
    <dd><ul>{% for v in bron.voorwaarden %}<li>{{ v | mdInline | safe }}</li>{% endfor %}</ul></dd>
    {%- endif %}
    {%- if bron.vergoeding %}
    <dt>Kosten en vergoeding</dt>
    <dd>{{ bron.vergoeding }}</dd>
    {%- endif %}
    {%- if bron.opmerking %}
    <dt>Let op</dt>
    <dd>{{ bron.opmerking }}</dd>
    {%- endif %}
  </dl>
  <p class="bron__link"><a href="{{ bron.url }}">Bekijk “{{ bron.titel }}” bij {{ bron.bron }}</a></p>
  <p class="bron__datum">Bron: {{ bron.bron }}. Gecontroleerd op <time datetime="{{ bron.gecontroleerd | datumISO }}">{{ bron.gecontroleerd | datumNL }}</time>.</p>
</article>
{%- endmacro %}

{#
  Foto met onderschrift. "foto" komt uit de front matter van een pagina:
    foto:
      src: /img/bloemerstraat.webp   # leeg laten zolang er nog geen foto is
      alt: Beschrijving van wat er op de foto te zien is
      onderschrift: Optioneel bijschrift
      beschrijving: Wat voor foto hier zou passen (alleen voor de placeholder)
  Zonder src toont de site een placeholder, zolang site.fotoPlaceholders aan staat.
#}
{% macro afbeelding(foto, site, variant="breed") -%}
{%- if foto and foto.src %}
<figure class="foto foto--{{ variant }}">
  <img src="{{ foto.src }}" alt="{{ foto.alt }}" loading="lazy" decoding="async">
  {%- if foto.onderschrift %}
  <figcaption>{{ foto.onderschrift }}</figcaption>
  {%- endif %}
</figure>
{%- elif foto and site.fotoPlaceholders %}
<figure class="foto foto--{{ variant }} foto--placeholder" aria-hidden="true">
  <div class="foto__vlak">
    <svg viewBox="0 0 24 24" focusable="false"><path d="M4 7h3l2-2h6l2 2h3v12H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
    <span>Foto volgt: {{ foto.beschrijving }}</span>
  </div>
</figure>
{%- endif %}
{%- endmacro %}

{# Eenvoudig informatieblok met titel en tekst (Markdown toegestaan). #}
{% macro infoBlok(titel, tekst, kopNiveau=3) -%}
<div class="infoblok">
  <h{{ kopNiveau }}>{{ titel }}</h{{ kopNiveau }}>
  {{ tekst | md | safe }}
</div>
{%- endmacro %}

{# Projectkaart voor overzichten. #}
{% macro projectKaart(project, statussen, kopNiveau=3) -%}
<article class="kaart project-kaart">
  <p class="project-kaart__status">{{ statusBadge(project.data.status, statussen) }}</p>
  <h{{ kopNiveau }} class="kaart__titel"><a href="{{ project.url }}">{{ project.data.title }}</a></h{{ kopNiveau }}>
  <p>{{ project.data.samenvatting }}</p>
</article>
{%- endmacro %}

{# Hoe mensen contact opnemen. Toont het e-mailadres uit site.js zodra dat is ingevuld. #}
{% macro contactTekst(site) -%}
{%- if site.contact.email -%}
Graag! Stuur je idee of voorstel naar <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>.
{%- else -%}
Op dit moment is er nog geen manier om ideeën in te sturen. Later openen we daar kanalen voor; in de nieuwsbrief lees je wanneer dat zover is.
{%- endif -%}
{%- endmacro %}

{#
  Veelgestelde vragen als accordion, met <details>: werkt zonder JavaScript.
  Dankzij name="faq" staat in moderne browsers steeds één antwoord open;
  oudere browsers laten de vragen los open- en dichtklappen.
#}
{% macro faqLijst(vragen, site) -%}
<div class="faq">
  {%- for item in vragen %}
  <details class="faq__item" name="faq"{% if item.id %} id="{{ item.id }}"{% endif %}>
    <summary class="faq__vraag">{{ item.vraag }}</summary>
    <div class="faq__antwoord">
      {%- if item.antwoord %}{{ item.antwoord | md | safe }}{% endif %}
      {%- if item.toonContact %}<p>{{ contactTekst(site) }}</p>{% endif %}
    </div>
  </details>
  {%- endfor %}
</div>
{%- endmacro %}
